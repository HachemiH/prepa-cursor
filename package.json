  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm": "pnpm exec ts-node ./node_modules/typeorm/cli",
    "migration:generate": "pnpm typeorm migration:generate -d src/core/config/database/typeorm-migrations.config.ts",
    "migration:run": "pnpm typeorm migration:run -d src/core/config/database/typeorm-migrations.config.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/core/config/database/typeorm-migrations.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm exec playwright test --config test/e2e/config.ts",
    "test:all": "pnpm lint && pnpm test || exit 0",
    "db:cleanup": "ts-node --transpile-only --project scripts/tsconfig.json scripts/cleanup-db.ts",
    "db:seed": "ts-node --transpile-only --project scripts/tsconfig.json scripts/seed-system-users.ts",
    "db:reset": "pnpm db:cleanup && pnpm db:seed"
  },
